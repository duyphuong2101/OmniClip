# ========================================================
# OmniClip Configuration & Social Platform Credentials
# ========================================================

# Path to Motion Studio directory (default: D:/Motion Studio)
MOTION_STUDIO_DIR="D:/Motion Studio"

# OmniClip Dashboard Port
PORT=4790

# Auto-publish immediately when Motion Studio finishes review/render? (true/false)
AUTO_PUBLISH=false

# Default platforms to publish (comma-separated: youtube,tiktok,facebook,instagram)
DEFAULT_PLATFORMS="youtube,tiktok,facebook,instagram"

# Default video privacy on platforms ("public", "unlisted", "private")
DEFAULT_PRIVACY="public"

# --------------------------------------------------------
# 1. YOUTUBE SHORTS (Google Cloud Console / YouTube Data API v3)
# --------------------------------------------------------
YOUTUBE_ENABLED=false
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""

# --------------------------------------------------------
# 2. TIKTOK (TikTok for Developers / Content Posting API)
# --------------------------------------------------------
TIKTOK_ENABLED=false
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REFRESH_TOKEN=""
# Optional Creator Access Token (if using direct token)
TIKTOK_ACCESS_TOKEN=""

# --------------------------------------------------------
# 3. FACEBOOK REELS (Meta for Developers / Graph API)
# --------------------------------------------------------
FACEBOOK_ENABLED=false
FACEBOOK_PAGE_ID=""
# Long-lived Page Access Token with pages_manage_posts & publish_video permissions
FACEBOOK_PAGE_ACCESS_TOKEN=""

# --------------------------------------------------------
# 4. INSTAGRAM REELS (Instagram Graph API)
# --------------------------------------------------------
INSTAGRAM_ENABLED=false
# Instagram Professional / Business Account ID (connected to Facebook Page)
INSTAGRAM_ACCOUNT_ID=""
# User/Page Access Token with instagram_content_publish permission
INSTAGRAM_ACCESS_TOKEN=""
# Public URL prefix if hosting video via public web server/tunnel (e.g. https://xyz.ngrok-free.app)
# Or leave blank to use OmniClip's Resumable Upload
INSTAGRAM_PUBLIC_HOST=""
